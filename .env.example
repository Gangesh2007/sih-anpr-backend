# .env.example
PROJECT_NAME="City-Wide ANPR System"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database (To be used in Phase 12)
DATABASE_URL="postgresql://user:password@localhost:5432/anpr_db"

# Computer Vision Configs (For future phases)
VEHICLE_MODEL_PATH="models/vehicle/yolov8s.pt"
VEHICLE_CONF_THRESHOLD=0.40

ROBOFLOW_API_KEY="your_api_key_here"
ROBOFLOW_MODEL_ID="license-plate-recognition-rxg4e"
PLATE_CONF_THRESHOLD=0.50

OCR_PROVIDER="paddleocr"
OCR_CONF_THRESHOLD=0.70

# Processing
PROCESS_EVERY_N_FRAMES=3
TRACK_MAX_AGE=30

# Storage
STORAGE_PATH="./data"